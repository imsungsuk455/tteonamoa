---
import festivals from "../../festivals.json";
import articles from "../data/articles.json";

const title = "떠나모아 | 이번 주말 축제·행사 일정 정리";
const description = "전국 축제·행사 일정을 날짜 순으로 정리합니다. 장소·문의처·방문 전 확인사항을 함께 제공합니다.";
const PUB = "ca-pub-3484572882367046";
const NIGHT = ["f-2648460", "f-2874909"];
const byId = Object.fromEntries(articles.map((a) => [a.id, a]));
const list = festivals.filter((x) => byId[x.id]);
const DAY = ["일", "월", "화", "수", "목", "금", "토"];
const fmt = (ymd) => {
  if (!ymd || ymd.length !== 8) return ymd || "";
  const y = +ymd.slice(0, 4), m = +ymd.slice(4, 6), d = +ymd.slice(6, 8);
  const w = DAY[new Date(y, m - 1, d).getDay()];
  return `${m}.${d}(${w})`;
};
const desc = "이번 주말 가볼 곳을 날짜 순으로 정리합니다. 야간·불꽃 축제부터 먹거리 장터까지, 장소와 문의처, 방문 전 확인사항을 담았습니다.";
---
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href="https://tteonamoa.org/">
<meta name="naver-site-verification" content="613b08ff25e700ee876e20ef44eb276f1177d287" />
<meta name="google-site-verification" content="SCnwxJPg6gtRKQxOsf54iaVaTOig5MJmHSFehDkJpao" />
<meta name="google-adsense-account" content={PUB}>
<script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${PUB}`} crossorigin="anonymous"></script>
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;600;700;900&display=swap" rel="stylesheet" />
<style>
:root{--canvas:#ffffff;--cloud:#f7f7f7;--ink:#222222;--muted:#6a6a6a;--line:#dddddd;--accent:#ff385c;--accent-deep:#e00b41;--serif:"Noto Serif KR",serif;--sans:Pretendard,-apple-system,"Noto Sans KR",sans-serif;--r-lg:20px;--r-md:14px;--r-sm:8px}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--sans);background:var(--cloud);color:var(--ink);line-height:1.7;font-weight:400;padding-bottom:40px}
.wrap{max-width:1020px;margin:0 auto;padding:0 20px}
.topbar{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.95);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.topbar .wrap{display:flex;align-items:center;gap:14px;height:60px;padding:0 20px}
.logo{font-family:var(--serif);font-weight:900;font-size:1.25rem;letter-spacing:-.4px;text-decoration:none;color:var(--ink)}
.logo em{font-style:normal;color:var(--accent)}
.tagline{font-size:.78rem;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:4px 12px;white-space:nowrap}
/* 히어로: 에디토리얼. 세리프 + 마커 하이라이트 + 데크 */
.hero{margin:32px 0 22px;background:var(--canvas);border:1px solid var(--line);border-radius:var(--r-lg);padding:46px 38px 40px;position:relative}
.hero .kicker{font-size:.78rem;letter-spacing:.12em;color:var(--accent);font-weight:700;margin-bottom:12px}
.hero h1{font-family:var(--serif);font-size:2.5rem;font-weight:700;letter-spacing:-1px;margin-bottom:14px;line-height:1.35}
.hero h1 mark{background:linear-gradient(transparent 62%, rgba(255,56,92,.22) 62%);color:inherit;padding:0 2px}
.hero p.deck{font-family:var(--serif);font-weight:500;color:var(--muted);font-size:1.06rem;line-height:1.9;max-width:540px}
.hero .note{font-size:.82rem;color:var(--muted);margin-top:16px}
.stats{display:flex;gap:10px;margin-top:26px;flex-wrap:wrap;align-items:baseline}
.stat{border-top:2px solid var(--ink);padding-top:8px;font-size:.8rem;color:var(--muted);margin-right:6px}
.stat b{display:block;font-family:var(--serif);font-weight:900;font-size:1.35rem;color:var(--ink);letter-spacing:-.5px}
.hero .cta{display:inline-block;margin-top:26px;background:var(--accent);color:#fff;font-weight:600;font-size:.95rem;text-decoration:none;padding:13px 28px;border-radius:var(--r-sm);box-shadow:0 2px 0 var(--accent-deep)}
.hero .cta:hover{background:var(--accent-deep)}
.hero .cta:active{transform:translateY(1px);box-shadow:none}
.notice{background:var(--cloud);border:1px solid var(--line);border-radius:12px;padding:12px 16px;font-size:.85rem;color:var(--muted);margin:0 2px 28px;line-height:1.7}
.sec-head{display:flex;align-items:flex-end;gap:14px;margin:36px 2px 8px}
.sec-head h2{font-family:var(--serif);font-size:1.55rem;font-weight:700;letter-spacing:-.5px;line-height:1.3}
.sec-head span{font-size:.84rem;color:var(--muted);padding-bottom:4px}
.sec-head h2::after{content:"";display:block;width:40px;height:3px;background:var(--accent);border-radius:2px;margin-top:8px}
.intro{max-width:640px;color:var(--muted);font-size:.92rem;line-height:1.85;margin:0 2px 22px}
/* 카드: 사진 우선 + 날짜 필 오버랩 (매거진 컷아웃) */
.grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
@media(max-width:760px){.grid{grid-template-columns:1fr}.hero h1{font-size:1.85rem}.hero{padding:34px 24px}}
.card{background:var(--canvas);border:1px solid var(--line);border-radius:var(--r-md);overflow:hidden;display:flex;flex-direction:column}
.card .thumb{position:relative;border-bottom:1px solid var(--line)}
.card .thumb img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;background:var(--cloud)}
.card .date-pill{position:absolute;left:12px;top:12px;background:#fff;border:1px solid var(--line);border-radius:999px;padding:5px 12px;font-family:var(--serif);font-weight:700;font-size:.82rem;letter-spacing:-.2px;color:var(--ink);box-shadow:0 1px 4px rgba(0,0,0,.08)}
.card .body{padding:16px 18px 18px;display:flex;flex-direction:column;gap:7px;flex:1}
.badges{display:flex;gap:6px;flex-wrap:wrap}
.badge{font-size:.72rem;font-weight:600;border-radius:999px;padding:3px 10px;letter-spacing:0}
.night{background:var(--ink);color:#fff}
.day{background:var(--cloud);border:1px solid var(--line);color:var(--muted)}
.region{background:var(--cloud);border:1px solid var(--line);color:var(--muted)}
.card h3{font-family:var(--serif);font-size:1.08rem;font-weight:700;letter-spacing:-.3px;line-height:1.5}
.card h3 a{color:var(--ink);text-decoration:none}
.card h3 a:hover{color:var(--accent-deep)}
.card .place{color:var(--muted);font-size:.84rem;line-height:1.6}
.card .dates{color:var(--ink);font-size:.84rem;font-weight:600}
.card .links{margin-top:auto;padding-top:8px}
.card .links a{color:var(--ink);font-size:.86rem;font-weight:600;text-decoration:none;border-bottom:2px solid var(--accent);padding-bottom:2px}
.card .links a:hover{color:var(--accent-deep)}
footer{margin-top:48px;background:var(--cloud);border-top:1px solid var(--line);padding:28px 20px;text-align:center;font-size:.8rem;color:var(--muted);line-height:2}
footer a{color:var(--muted);text-decoration:none;margin:0 8px}
footer a:hover{color:var(--ink)}
</style>
</head>
<body>
<div class="topbar"><div class="wrap">
<a class="logo" href="/">떠나<em>모아</em></a>
<span class="tagline">주말 축제·행사 일정</span>
</div></div>
<div class="wrap">
<section class="hero">
<p class="kicker">Tteonamoa · 주말 여행지 큐레이션</p>
<h1>이번 주말, <mark>어디?</mark></h1>
<p class="deck">전국 축제 일정을 날짜 순으로 정리합니다. 야간·불꽃 축제부터 먹거리 장터까지, 장소와 문의처, 방문 전 확인사항을 담았습니다.</p>
<p class="note">떠나모아는 공개 정보를 직접 확인해 매일 정리합니다.</p>
<div class="stats">
<span class="stat"><b>{list.length}</b>정리된 축제</span>
<span class="stat"><b>10월</b>가을 축제 성수기</span>
</div>
<a class="cta" href="#festivals">축제 일정 보러 가기</a>
</section>
<div class="notice">일정·장소·요금은 변동될 수 있습니다. 방문 전 각 축제 공식 홈페이지와 문의처에서 최종 내용을 확인하세요. 출처: 한국관광공사 TourAPI.</div>
<section id="festivals">
<div class="sec-head"><h2>축제·행사 일정</h2><span>종료일 순 · 방문 전 공식 홈페이지 확인</span></div>
<div class="grid">
{list.map((x) => {
  const a = byId[x.id];
  return (
  <article class="card">
  <div class="thumb">
  <span class="date-pill">{fmt(x.start)}</span>
  <img src={x.image || ""} alt={a?.imageAlt || `${x.title} 축제 현장`} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
  </div>
  <div class="body">
  <div class="badges">{NIGHT.includes(x.id) ? <span class="badge night">야간</span> : <span class="badge day">주간</span>}<span class="badge region">{x.region}</span></div>
  <h3><a href={`/articles/${x.slug}/`}>{x.title}</a></h3>
  <div class="place">{x.place}</div>
  <div class="dates">{fmt(x.start)}~{fmt(x.end)}</div>
  <div class="links"><a href={`/articles/${x.slug}/`}>일정·장소 보기</a></div>
  </div>
  </article>
  );
})}
</div>
</section>
</div>
<footer>
<a href="/about/">소개</a>·<a href="/privacy/">개인정보</a>·<a href="/terms/">약관</a>·<a href="/contact/">문의</a><br>
출처: 한국관광공사 TourAPI (원문 정보 병기)<br>
최종 일정은 반드시 공식 홈페이지에서 확인하세요.
</footer>
</body>
</html>