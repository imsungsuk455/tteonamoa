---
const { title, description, canonical } = Astro.props;
const PUB = "ca-pub-3484572882367046";
---
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="naver-site-verification" content="613b08ff25e700ee876e20ef44eb276f1177d287" />
<meta name="google-site-verification" content="SCnwxJPg6gtRKQxOsf54iaVaTOig5MJmHSFehDkJpao" />
<meta name="google-adsense-account" content={PUB}>
<script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${PUB}`} crossorigin="anonymous"></script>
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;600;700;900&display=swap" rel="stylesheet" />
<style is:global>
:root{--canvas:#ffffff;--cloud:#f7f7f7;--ink:#222222;--muted:#6a6a6a;--line:#dddddd;--accent:#ff385c;--accent-deep:#e00b41;--serif:"Noto Serif KR",serif;--sans:Pretendard,-apple-system,"Noto Sans KR",sans-serif;--r-lg:20px;--r-md:14px;--r-sm:8px}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--sans);background:var(--cloud);color:var(--ink);line-height:1.8;font-weight:400}
.wrap{max-width:760px;margin:0 auto;padding:0 20px 44px;background:var(--canvas)}
.top{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.95);backdrop-filter:blur(8px);border-bottom:1px solid var(--line);height:60px;display:flex;align-items:center}
.top .inner{max-width:760px;margin:0 auto;padding:0 20px;width:100%;display:flex;align-items:center;gap:14px}
.top a.brand{font-family:var(--serif);font-weight:900;font-size:1.18rem;letter-spacing:-.4px;text-decoration:none;color:var(--ink)}
.top a.brand em{font-style:normal;color:var(--accent)}
.top .crumb{margin-left:auto;font-size:.82rem;color:var(--muted);text-decoration:none}
.top .crumb:hover{color:var(--ink)}
h1{font-family:var(--serif);font-size:1.95rem;font-weight:700;letter-spacing:-.6px;margin:30px 0 6px;line-height:1.4}
.deck{font-family:var(--serif);font-weight:500;color:var(--muted);font-size:1.02rem;line-height:1.85;margin:0 0 14px;letter-spacing:-.2px}
h2{font-family:var(--serif);font-size:1.3rem;font-weight:600;letter-spacing:-.4px;margin:36px 0 12px;line-height:1.45}
h2::after{content:"";display:block;width:34px;height:3px;background:var(--accent);border-radius:2px;margin-top:8px}
p{margin:12px 0;font-size:.96rem}
.meta{color:var(--muted);font-size:.85rem;margin-bottom:16px;line-height:1.7}
.byline{font-size:.82rem;color:var(--muted);background:var(--cloud);border:1px solid var(--line);border-radius:10px;padding:9px 14px;margin:0 0 6px}
.byline a{color:var(--ink);text-decoration:underline;text-underline-offset:2px}
img.hero{width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;background:var(--cloud);border-radius:var(--r-lg);border:1px solid var(--line);margin:16px 0 0}
.cap{font-size:.78rem;color:var(--muted);margin:6px 0 4px}
.box{background:var(--cloud);border:1px solid var(--line);border-radius:12px;padding:16px 18px;margin:14px 0;font-size:.93rem}
.related{list-style:none;margin:8px 0 12px;padding:0}
.related li{margin:9px 0;padding-left:18px;position:relative}
.related li::before{content:"→";position:absolute;left:0;top:0;color:var(--accent);font-size:.9rem}
.related a{color:var(--ink);font-size:.95rem;font-weight:600;text-decoration:none}
.related a:hover{color:var(--accent-deep)}
footer{margin-top:40px;background:var(--cloud);border-top:1px solid var(--line);padding:26px 20px;text-align:center;font-size:.8rem;color:var(--muted);line-height:2}
footer a{color:var(--muted);text-decoration:none;margin:0 8px}
footer a:hover{color:var(--ink)}
@media(max-width:560px){h1{font-size:1.55rem}.top .crumb{display:none}}
</style>
</head>
<body>
<div class="top"><div class="inner">
<a class="brand" href="/">떠나<em>모아</em></a>
<a class="crumb" href="/">주말 축제·행사 일정</a>
</div></div>
<div class="wrap">
<slot />
<footer><a href="/about/">소개</a>·<a href="/privacy/">개인정보</a>·<a href="/terms/">약관</a>·<a href="/contact/">문의</a><br>출처: 한국관광공사 TourAPI · 최종 일정은 반드시 공식 홈페이지에서 확인하세요.</footer>
</div>
</body>
</html>