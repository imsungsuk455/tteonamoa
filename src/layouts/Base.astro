---
const { title, description, canonical } = Astro.props;
const PUB = "ca-pub-3484572882367046";
---
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="naver-site-verification" content="613b08ff25e700ee876e20ef44eb276f1177d287" />
<meta name="google-site-verification" content="SCnwxJPg6gtRKQxOsf54iaVaTOig5MJmHSFehDkJpao" />
<meta name="google-adsense-account" content={PUB}>
<script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${PUB}`} crossorigin="anonymous"></script>
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
<style is:global>
/* better-design Airbnb tokens (2026-04 production extract) */
:root{
--background:#FFFFFF;--foreground:#222222;
--card:#FFFFFF;--card-foreground:#222222;
--primary:#FF385C;--primary-foreground:#FFFFFF;
--secondary:#222222;--secondary-foreground:#FFFFFF;
--muted:#F7F7F7;--muted-foreground:#6A6A6A;
--border:#DDDDDD;--input:#F7F7F7;--ring:#222222;--destructive:#C13515;
--radius:0.75rem;
--rausch:radial-gradient(circle at center,#FF385C 0%,#E61E4D 27.5%,#E31C5F 40%,#D70466 57.5%,#BD1E59 75%,#BD1E59 100%);
--shadow-xs:0 1px 2px rgba(0,0,0,.06);
--shadow-sm:0 1px 2px rgba(0,0,0,.08),0 4px 12px rgba(0,0,0,.05);
--shadow:0 2px 4px rgba(0,0,0,.08),0 4px 12px rgba(0,0,0,.08);
--font:Pretendard,-apple-system,"Noto Sans KR",sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--font);background:var(--background);color:var(--foreground);line-height:1.8;font-weight:400;-webkit-font-smoothing:antialiased}
.wrap{max-width:760px;margin:0 auto;padding:0 20px 44px;background:var(--background)}
.top{position:sticky;top:0;z-index:20;background:rgba(255,255,255,.96);backdrop-filter:blur(8px);border-bottom:1px solid var(--border);height:60px;display:flex;align-items:center}
.top .inner{max-width:760px;margin:0 auto;padding:0 20px;width:100%;display:flex;align-items:center;gap:14px}
.top a.brand{font-weight:800;font-size:1.2rem;letter-spacing:-.4px;text-decoration:none;color:var(--foreground)}
.top a.brand em{font-style:normal;color:var(--primary)}
.top .crumb{margin-left:auto;font-size:.82rem;color:var(--muted-foreground);text-decoration:none}
.top .crumb:hover{color:var(--foreground)}
h1{font-size:1.9rem;font-weight:800;letter-spacing:-.7px;margin:28px 0 4px;line-height:1.4}
.deck{color:var(--muted-foreground);font-size:1.02rem;line-height:1.85;margin:0 0 14px}
h2{font-size:1.28rem;font-weight:700;letter-spacing:-.4px;margin:34px 0 10px;line-height:1.45}
p{margin:12px 0;font-size:.96rem}
.meta{color:var(--muted-foreground);font-size:.85rem;margin-bottom:16px;line-height:1.7}
.byline{font-size:.82rem;color:var(--muted-foreground);background:var(--muted);border:1px solid var(--border);border-radius:10px;padding:9px 14px;margin:0 0 6px}
.byline a{color:var(--foreground);text-decoration:underline;text-underline-offset:2px}
img.hero{width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;background:var(--muted);border-radius:calc(var(--radius)+4px);border:1px solid var(--border);margin:16px 0 0}
.cap{font-size:.78rem;color:var(--muted-foreground);margin:6px 0 4px}
.box{background:var(--muted);border:1px solid var(--border);border-radius:12px;padding:16px 18px;margin:14px 0;font-size:.93rem}
.fact-table{width:100%;border-collapse:collapse;margin:14px 0 6px;font-size:.9rem;background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden}
.fact-table th,.fact-table td{padding:10px 14px;border-bottom:1px solid var(--border);text-align:left;vertical-align:top;line-height:1.65}
.fact-table tr:last-child th,.fact-table tr:last-child td{border-bottom:none}
.fact-table th{width:110px;background:var(--muted);font-weight:700;color:var(--muted-foreground);font-size:.85rem;white-space:nowrap}
.fact-table td{color:var(--foreground)}
@media(max-width:560px){.fact-table th{width:88px;padding:8px 10px}.fact-table td{padding:8px 10px}}
.related{list-style:none;margin:8px 0 12px;padding:0}
.related li{margin:9px 0;padding-left:18px;position:relative}
.related li::before{content:"→";position:absolute;left:0;top:0;color:var(--primary);font-size:.9rem}
.related a{color:var(--foreground);font-size:.95rem;font-weight:600;text-decoration:none}
.related a:hover{color:var(--primary)}
footer{margin-top:40px;background:var(--muted);border-top:1px solid var(--border);padding:26px 20px;text-align:center;font-size:.8rem;color:var(--muted-foreground);line-height:2}
footer a{color:var(--muted-foreground);text-decoration:none;margin:0 8px}
footer a:hover{color:var(--foreground)}
a:focus-visible,button:focus-visible{outline:2px solid var(--ring);outline-offset:2px}
@media(max-width:560px){h1{font-size:1.55rem}.top .crumb{display:none}}
</style>
</head>
<body>
<div class="top"><div class="inner">
<a class="brand" href="/">떠나<em>모아</em></a>
<a class="crumb" href="/">주말 축제·행사 일정</a>
</div></div>
<div class="wrap">
<slot />
<footer><a href="/about/">소개</a>·<a href="/privacy/">개인정보</a>·<a href="/terms/">약관</a>·<a href="/contact/">문의</a><br>출처: 한국관광공사 TourAPI · 최종 일정은 반드시 공식 홈페이지에서 확인하세요.</footer>
</div>
</body>
</html>