---
const { title, description, canonical } = Astro.props;
const PUB = "ca-pub-3484572882367046";
---
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="naver-site-verification" content="613b08ff25e700ee876e20ef44eb276f1177d287" />
<meta name="google-site-verification" content="SCnwxJPg6gtRKQxOsf54iaVaTOig5MJmHSFehDkJpao" />
<meta name="google-adsense-account" content={PUB}>
<script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${PUB}`} crossorigin="anonymous"></script>
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
<style is:global>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Pretendard,-apple-system,"Noto Sans KR",sans-serif;background:#f3f5fa;color:#101828;line-height:1.8;padding-bottom:80px}
.wrap{max-width:760px;margin:0 auto;padding:0 18px 30px;background:#fff}
.top{padding:16px 0;border-bottom:1px solid #e4e9f2}
.top a{font-weight:800;text-decoration:none;color:#101828}
h1{font-size:1.5rem;letter-spacing:-.5px;margin:22px 0 8px;line-height:1.5}
.meta{color:#667085;font-size:.85rem;margin-bottom:18px;line-height:1.7}
h2{font-size:1.15rem;margin:28px 0 10px}
img.hero{width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;background:#e8edf5;border-radius:12px;margin:6px 0}
.cap{font-size:.78rem;color:#98a2b3;margin-bottom:6px}
.byline{font-size:.82rem;color:#667085;background:#f8fafc;border:1px solid #e4e9f2;border-radius:8px;padding:8px 12px}
.byline a{color:#0e9f6e}
.box{background:#f8fafc;border:1px solid #e4e9f2;border-radius:12px;padding:14px 16px;margin:14px 0;font-size:.93rem}
p{margin:10px 0;font-size:.95rem}
footer{margin-top:30px;padding:18px 0;text-align:center;font-size:.8rem;color:#98a2b3}
footer a{color:#0e9f6e;text-decoration:none;margin:0 6px}
</style>
</head>
<body>
<div class="wrap">
<div class="top"><a href="/">떠나모아</a></div>
<slot />
<footer><a href="/">홈</a> · <a href="/about">소개</a> · <a href="/privacy">개인정보</a></footer>
</div>
</body>
</html>
